/* ============================================================
   host-mobile.css — تظبيط شاشة الهوست (اللعب المباشر) على الموبايل
   يتحط في CSS/ ويتربط بعد host-gamen.css و countdown.css
   ============================================================ */

html, body { overflow-x: hidden; }

@media (max-width: 720px) {
  /* ---- الهيدر ---- */
  .game-header { padding: 10px 14px !important; }
  .player-count { font-size: 15px !important; padding: 6px 12px !important; }

  /* ---- الشاشات العامة ---- */
  .screen-center { padding: 16px 14px !important; box-sizing: border-box; }
  .huge-title { font-size: clamp(2rem, 9vw, 3.2rem) !important; margin-bottom: 20px; text-align: center; }
  .info-title { font-size: 1.5rem !important; padding: 0 8px; text-align: center; line-height: 1.4; }

  /* ---- شاشة السؤال ---- */
  .q-header { padding: 12px 14px !important; }
  .q-header h1 { font-size: 1.35rem !important; line-height: 1.45; text-align: center; margin: 0; }

  .q-middle {
    display: flex !important;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 14px !important;
  }
  .timer-wrapper { order: 1; }
  .answers-counter-wrapper { order: 2; }
  .q-media { order: 3; flex: 1 1 100%; max-height: 30vh; min-height: 0 !important; }
  .q-media img { max-height: 30vh; width: auto; max-width: 100%; object-fit: contain; }
  .timer-circle { width: 56px !important; height: 56px !important; font-size: 1.5rem !important; }

  .q-answers-grid {
    grid-template-columns: 1fr !important;
    gap: 10px !important;
    padding: 10px 14px 80px !important;
  }
  .ans-box { min-height: 56px !important; padding: 10px 14px !important; font-size: 1rem !important; }

  /* ---- النتائج (inline styles محتاجة !important) ---- */
  #screen-results { padding-bottom: 80px !important; }
  #result-q-text { margin-bottom: 24px !important; font-size: 1.35rem !important; padding: 0 12px; }
  .chart-container { gap: 8px !important; padding: 0 10px !important; max-height: 40vh; }

  /* ---- لوحة الصدارة ---- */
  #screen-leaderboard { padding-top: 20px !important; }
  #screen-leaderboard .huge-title { margin-bottom: 20px !important; }
  .leaderboard-list { width: 100% !important; padding: 0 12px; box-sizing: border-box; }

  /* ---- المنصة ---- */
  .podium-main-title { font-size: 2rem !important; margin-bottom: 12px !important; }
  .podium-container { gap: 6px !important; width: 100%; padding: 0 8px; box-sizing: border-box; }
  .w-name { font-size: 0.95rem !important; }
  .w-score { font-size: 0.9rem !important; }
  .btn-return-admin { width: calc(100% - 28px); margin: 14px; }

  /* ---- زرار Next ---- */
  #btn-next {
    right: 14px !important;
    bottom: 14px !important;
    padding: 12px 22px !important;
    font-size: 1rem !important;
  }
}